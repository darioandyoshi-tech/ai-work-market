{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/AGENT_QUICKSTART",
      "destination": "/AGENT_QUICKSTART.md"
    },
    {
      "source": "/AGENT_QUICKSTART.md",
      "destination": "/AGENT_QUICKSTART.md"
    },
    {
      "source": "/agent-commerce",
      "destination": "/agent-commerce.html"
    },
    {
      "source": "/blog/awm-vs-x402",
      "destination": "/blog/awm-vs-x402.html"
    },
    {
      "source": "/blog/awm-vs-x402/",
      "destination": "/blog/awm-vs-x402.html"
    },
    {
      "source": "/first-agents",
      "destination": "/first-agents.html"
    },
    {
      "source": "/founding-testers",
      "destination": "/founding-testers.html"
    },
    {
      "source": "/integration-sprint",
      "destination": "/integration-sprint.html"
    },
    {
      "source": "/manifesto",
      "destination": "/manifesto.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/products/agent-commerce-market-map",
      "destination": "/products/market-map-sample.md"
    },
    {
      "source": "/products/awm-work-intake-n8n",
      "destination": "/products/awm-work-intake-n8n/sample.md"
    },
    {
      "source": "/purchase-complete",
      "destination": "/purchase-complete.html"
    },
    {
      "source": "/quickstart",
      "destination": "/AGENT_QUICKSTART.md"
    },
    {
      "source": "/treasury",
      "destination": "/treasury.html"
    },
    {
      "source": "/trust",
      "destination": "/trust.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/agent.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/webhook-deliverer",
      "schedule": "*/2 * * * *"
    }
  ]
}
