# AI Work Market Base Sepolia example env
# Copy to .env.base-sepolia.local and fill with TESTNET keys only.

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Buyer/funder key. Needs Base Sepolia ETH for gas and Base Sepolia USDC for escrow funding.
PRIVATE_KEY=0xREPLACE_WITH_TESTNET_BUYER_PRIVATE_KEY
DEPLOYER_ADDRESS=0xREPLACE_WITH_BUYER_ADDRESS

# Seller/agent key. Needs a little Base Sepolia ETH to submit proof.
SELLER_PRIVATE_KEY=0xREPLACE_WITH_TESTNET_SELLER_PRIVATE_KEY
SELLER_ADDRESS=0xREPLACE_WITH_SELLER_ADDRESS

# Live Base Sepolia deployment
ESCROW=0x489C36738F46e395b4cd26DDf0f85756686A2f07
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# 0.01 USDC in 6-decimal raw units
E2E_USDC_AMOUNT=10000

# Mainnet Base x402 receipt verification. Leave unset in local smoke tests unless
# testing the mutating consume=true flow.
BASE_RPC_URL=https://mainnet.base.org
BASE_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
AWM_X402_TREASURY=0x8d32448cbad55a3d3B12DE901e57782C409399B7
AWM_X402_CONSUME_SECRET=replace-with-server-side-hmac-secret
AWM_X402_RATE_LIMIT_MAX=60
AWM_X402_RATE_LIMIT_WINDOW_MS=60000
AWM_X402_MIN_CONFIRMATIONS=1

# Durable receipt-consumption store for POST consume=true.
# Production must use a shared atomic backend; local JSON is development-only.
AWM_X402_RECEIPT_STORE_BACKEND=upstash-redis
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# AWM_X402_ALLOW_LOCAL_RECEIPT_STORE=1 # development escape hatch only
